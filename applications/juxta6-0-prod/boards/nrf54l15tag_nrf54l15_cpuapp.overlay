/*
 * juxta6-0-prod: un-hog SKY13348 + SAADC VDD + MX25L3233 (32 Mbit) on spi00.
 *
 * Sensors + external NOR use zephyr,deferred-init so their driver probes run
 * from main() after the CR2032 contact-settle sleep (not during POST_KERNEL).
 */

/ {
	zephyr,user {
		/* 0 = internal VDD (lib/juxta_vdd), 1 = LIGHT_SENSE (src/juxta_light). */
		io-channels = <&adc 0>, <&adc 1>;
	};

	lht_sns {
		compatible = "gpio-leds";

		/* RV2C010UNT2L gate. Active-high connects the 2.7 kΩ load. */
		lht_sns_ctrl: lht_sns_ctrl {
			gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		spi-flash0 = &mx25l32;
		spi-mem = &mx25l32;
		watchdog0 = &wdt31;
	};
};

/* Hardware watchdog for field hang recovery (runs from LFCLK, which stops
 * in System OFF, so shelf mode is unaffected). */
&wdt31 {
	status = "okay";
};

&gpio1 {
	/delete-node/ antenna_switch_v1;
	/delete-node/ antenna_switch_v2;
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <14>;
		zephyr,oversampling = <8>;
		zephyr,vref-mv = <900>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
	};

	/* LIGHT_SENSE, P1.14. External pin can swing toward VDD, so GAIN_1_4
	 * with the 0.9 V reference (full scale 3.6 V). GAIN_1 clips above 0.9 V. */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <14>;
		zephyr,oversampling = <8>;
		zephyr,vref-mv = <900>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
	};
};

&pinctrl {
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};
};

&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";

	mx25l32: mx25l3233f@0 {
		compatible = "jedec,spi-nor";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <8000000>;
		jedec-id = [c2 20 16];
		size = <0x2000000>; /* 32 Mbit = 4 MiB */
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <100000>;
		/* Suspend into deep power-down between flash API calls.
		 * Requires CONFIG_PM_DEVICE_RUNTIME and
		 * CONFIG_PM_DEVICE_RUNTIME_DEFAULT_ENABLE=n in prj.conf.
		 */
		zephyr,pm-device-runtime-auto;
		zephyr,deferred-init;
	};
};

/*
 * SoC dts marks this TWIM zephyr,pm-device-runtime-auto. With runtime PM on,
 * that suspends the bus at boot (pins disconnected) and the first ADXL
 * transaction returns -EIO. NOR deep power-down does not need I2C runtime PM.
 */
&i2c21 {
	/delete-property/ zephyr,pm-device-runtime-auto;
};

/* Probe after contact settle in main() — see juxta6-0-prod src/main.c. */
&adxl367 {
	zephyr,deferred-init;
};

&bme688 {
	zephyr,deferred-init;
};

&bmi270 {
	zephyr,deferred-init;
};
