/*
 * tag-nor-dpd: MX25L3233F (32 Mbit) on spi00, identical NOR node to
 * juxta6-0-prod (has-dpd + zephyr,pm-device-runtime-auto + deferred-init).
 * Keep in sync with applications/juxta6-0-prod/boards/*.overlay.
 */

/ {
	aliases {
		spi-flash0 = &mx25l32;
		spi-mem = &mx25l32;
	};
};

&pinctrl {
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};
};

&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";

	mx25l32: mx25l3233f@0 {
		compatible = "jedec,spi-nor";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <8000000>;
		jedec-id = [c2 20 16];
		size = <0x2000000>; /* 32 Mbit = 4 MiB */
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <100000>;
		/* Suspend into deep power-down between flash API calls. */
		zephyr,pm-device-runtime-auto;
		zephyr,deferred-init;
	};
};
